---
/** Projects page, shared by every locale: newest project first. */
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocale, useTranslations } from '../../i18n/utils';
import { formatYearMonth, getLocalizedCollection } from '../../lib/content';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const entries = (await getLocalizedCollection('projects', locale)).sort((a, b) =>
	b.data.date.localeCompare(a.data.date),
);
const projects = await Promise.all(
	entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

// Work in progress ("Currently building" / "Next up"), from src/content/pages/<locale>/projects.md.
const page = await getEntry('pages', `${locale}/projects`);
const building = page?.data.building ?? [];
const nextUp = page?.data.nextUp ?? [];

const isDraft =
	entries.some((entry) => entry.data.translationStatus === 'draft') || page?.data.translationStatus === 'draft';
---

<BaseLayout
	title={t('nav.projects')}
	description={t('meta.projects')}
	draft={entries.length || page ? isDraft : undefined}
>
	<h1>{t('nav.projects')}</h1>

	{
		(building.length > 0 || nextUp.length > 0) && (
			<section class="progress" aria-label={`${t('projects.building')} / ${t('projects.nextUp')}`}>
				{[
					{ heading: t('projects.building'), items: building },
					{ heading: t('projects.nextUp'), items: nextUp },
				]
					.filter((group) => group.items.length > 0)
					.map((group) => (
						<div>
							<h2>{group.heading}</h2>
							<ul>
								{group.items.map((item) => (
									<li>
										<strong>{item.title}{locale === 'ja' ? '：' : ':'}</strong>{locale === 'ja' ? '' : ' '}{item.summary}
									</li>
								))}
							</ul>
						</div>
					))}
			</section>
		)
	}

	{entries.length === 0 && <p>{t('page.comingSoon')}</p>}

	{
		projects.map(({ entry, Content }) => {
			const { title, summary, stack, role, date, event, repo, demo, showcase, cover, coverAlt } = entry.data;
			const links = [
				demo && { href: demo, label: t('projects.demo') },
				repo && { href: repo, label: t('projects.repo') },
				showcase && { href: showcase, label: t('projects.showcase') },
			].filter((link): link is { href: string; label: string } => Boolean(link));
			return (
				<article aria-labelledby={`p-${entry.id}`}>
					<h2 id={`p-${entry.id}`}>{title}</h2>
					<p class="meta">{[event, formatYearMonth(date, locale)].filter(Boolean).join(' · ')}</p>
					{cover && cover.width === cover.height && (
						<Image
							class="cover logo"
							src={cover}
							alt={coverAlt ?? ''}
							widths={[320, 640]}
							sizes="(max-width: 360px) 100vw, 20rem"
						/>
					)}
					{cover && cover.width !== cover.height && (
						<>
							{/* Popover API: the browser opens and closes it, with no JavaScript. */}
							<button
								type="button"
								class="cover-button"
								popovertarget={`full-${entry.id.replace('/', '-')}`}
								aria-label={`${t('projects.enlarge')}: ${title}`}
							>
								<Image
									class="cover"
									src={cover}
									alt={coverAlt ?? ''}
									widths={[320, 640]}
									sizes="(max-width: 360px) 100vw, 20rem"
								/>
							</button>
							<div id={`full-${entry.id.replace('/', '-')}`} popover class="lightbox">
								<button
									type="button"
									class="close"
									popovertarget={`full-${entry.id.replace('/', '-')}`}
									popovertargetaction="hide"
								>
									{t('projects.close')}
								</button>
								{/* Hidden until opened, so the lazy full-size image loads only on click. */}
								<Image src={cover} alt={coverAlt ?? ''} loading="lazy" width={cover.width} height={cover.height} />
							</div>
						</>
					)}
					<p class="summary">{summary}</p>
					<dl>
						<dt>{t('projects.role')}</dt>
						<dd>{role}</dd>
						<dt>{t('projects.stack')}</dt>
						<dd>
							<ul class="stack">
								{stack.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</dd>
					</dl>
					<div class="body">
						<Content />
					</div>
					{links.length > 0 && (
						<ul class="links">
							{links.map((link) => (
								<li>
									<a href={link.href} rel="noopener">
										{link.label}
									</a>
								</li>
							))}
						</ul>
					)}
				</article>
			);
		})
	}
</BaseLayout>

<style>
	/* Work in progress: a quieter box above the finished projects. */
	.progress {
		display: grid;
		gap: 1rem;
		margin-top: 1.5rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: 0.5rem;
		background: var(--color-surface);
		font-size: 0.9375rem;
	}

	.progress h2 {
		margin: 0;
		color: var(--color-muted);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.progress ul {
		margin: 0.375rem 0 0;
		padding-left: 1.25rem;
	}

	.progress li + li {
		margin-top: 0.25rem;
	}

	article {
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-border);
	}

	h2 {
		margin: 0;
		font-size: 1.375rem;
	}

	.meta {
		margin: 0.25rem 0 0;
		color: var(--color-muted);
		font-size: 0.875rem;
	}

	.cover {
		display: block;
		width: 100%;
		max-width: 20rem;
		height: auto;
		margin-top: 1rem;
		border: 1px solid var(--color-border);
		border-radius: 0.5rem;
	}

	/* Square images are logos: show them small. */
	.cover.logo {
		max-width: 6rem;
	}

	/* A thumbnail that opens the full-size image. */
	.cover-button {
		display: block;
		margin: 0;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
	}

	.cover-button:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 3px;
		border-radius: 0.5rem;
	}

	.lightbox {
		width: fit-content;
		max-width: 96vw;
		max-height: 96vh;
		padding: 0;
		border: 0;
		background: transparent;
		overflow: visible;
	}

	.lightbox::backdrop {
		background: rgb(0 0 0 / 0.85);
	}

	.lightbox img {
		display: block;
		max-width: 96vw;
		max-height: calc(96vh - 3rem);
		width: auto;
		height: auto;
		border-radius: 0.5rem;
	}

	.lightbox .close {
		display: block;
		margin: 0 0 0.5rem auto;
		padding: 0.375rem 0.875rem;
		border: 1px solid rgb(255 255 255 / 0.5);
		border-radius: 999px;
		background: rgb(0 0 0 / 0.6);
		color: #fff;
		font: inherit;
		font-size: 0.875rem;
		cursor: pointer;
	}

	.summary {
		margin: 0.75rem 0 0;
	}

	dl {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.375rem 1rem;
		margin: 1rem 0 0;
		font-size: 0.9375rem;
	}

	dt {
		color: var(--color-muted);
	}

	dd {
		margin: 0;
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.stack li {
		padding: 0.0625rem 0.5rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-surface);
		font-size: 0.8125rem;
	}

	.body :global(ul) {
		margin: 1rem 0 0;
		padding-left: 1.25rem;
	}

	.body :global(li + li) {
		margin-top: 0.375rem;
	}

	.body :global(p) {
		margin: 1rem 0 0;
	}

	.body :global(code) {
		font-size: 0.875em;
		overflow-wrap: anywhere;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}
</style>
