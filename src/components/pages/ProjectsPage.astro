---
/** Projects page, shared by every locale: newest project first. */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocale, useTranslations } from '../../i18n/utils';
import { formatYearMonth, getLocalizedCollection } from '../../lib/content';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const entries = (await getLocalizedCollection('projects', locale)).sort((a, b) =>
	b.data.date.localeCompare(a.data.date),
);
const projects = await Promise.all(
	entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const isDraft = entries.some((entry) => entry.data.translationStatus === 'draft');
---

<BaseLayout title={t('nav.projects')} description={t('meta.projects')} draft={entries.length ? isDraft : undefined}>
	<h1>{t('nav.projects')}</h1>

	{entries.length === 0 && <p>{t('page.comingSoon')}</p>}

	{
		projects.map(({ entry, Content }) => {
			const { title, summary, stack, role, date, event, repo, demo, showcase, cover, coverAlt } = entry.data;
			const links = [
				demo && { href: demo, label: t('projects.demo') },
				repo && { href: repo, label: t('projects.repo') },
				showcase && { href: showcase, label: t('projects.showcase') },
			].filter((link): link is { href: string; label: string } => Boolean(link));
			return (
				<article aria-labelledby={`p-${entry.id}`}>
					<h2 id={`p-${entry.id}`}>{title}</h2>
					<p class="meta">{[event, formatYearMonth(date, locale)].filter(Boolean).join(' · ')}</p>
					{cover && (
						<Image
							class:list={['cover', { logo: cover.width === cover.height }]}
							src={cover}
							alt={coverAlt ?? ''}
							widths={[320, 640]}
							sizes="(max-width: 360px) 100vw, 20rem"
						/>
					)}
					<p class="summary">{summary}</p>
					<dl>
						<dt>{t('projects.role')}</dt>
						<dd>{role}</dd>
						<dt>{t('projects.stack')}</dt>
						<dd>
							<ul class="stack">
								{stack.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</dd>
					</dl>
					<div class="body">
						<Content />
					</div>
					{links.length > 0 && (
						<ul class="links">
							{links.map((link) => (
								<li>
									<a href={link.href} rel="noopener">
										{link.label}
									</a>
								</li>
							))}
						</ul>
					)}
				</article>
			);
		})
	}
</BaseLayout>

<style>
	article {
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-border);
	}

	h2 {
		margin: 0;
		font-size: 1.375rem;
	}

	.meta {
		margin: 0.25rem 0 0;
		color: var(--color-muted);
		font-size: 0.875rem;
	}

	.cover {
		display: block;
		width: 100%;
		max-width: 20rem;
		height: auto;
		margin-top: 1rem;
		border: 1px solid var(--color-border);
		border-radius: 0.5rem;
	}

	/* Square images are logos: show them small. */
	.cover.logo {
		max-width: 6rem;
	}

	.summary {
		margin: 0.75rem 0 0;
	}

	dl {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.375rem 1rem;
		margin: 1rem 0 0;
		font-size: 0.9375rem;
	}

	dt {
		color: var(--color-muted);
	}

	dd {
		margin: 0;
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.stack li {
		padding: 0.0625rem 0.5rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-surface);
		font-size: 0.8125rem;
	}

	.body :global(ul) {
		margin: 1rem 0 0;
		padding-left: 1.25rem;
	}

	.body :global(li + li) {
		margin-top: 0.375rem;
	}

	.body :global(p) {
		margin: 1rem 0 0;
	}

	.body :global(code) {
		font-size: 0.875em;
		overflow-wrap: anywhere;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}
</style>
