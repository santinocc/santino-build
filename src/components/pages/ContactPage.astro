---
/** Contact page, shared by every locale: the Markdown body of pages/<locale>/contact.md. */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocale, useTranslations } from '../../i18n/utils';
import { formspreeFormId } from '../../config';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const entry = await getEntry('pages', `${locale}/contact`);
const Content = entry ? (await render(entry)).Content : undefined;
---

<BaseLayout
	title={entry?.data.title ?? t('nav.contact')}
	description={entry?.data.description ?? t('meta.contact')}
	draft={entry ? entry.data.translationStatus === 'draft' : undefined}
>
	<h1>{entry?.data.title ?? t('nav.contact')}</h1>

	{
		Content ? (
			<div class="body">
				<Content />
			</div>
		) : (
			<p>{t('page.comingSoon')}</p>
		)
	}

	{
		formspreeFormId && (
			<section aria-labelledby="form-heading">
				<h2 id="form-heading">{t('contact.formHeading')}</h2>
				{/* Plain HTML POST: works without JavaScript. Formspree shows its own confirmation page. */}
				<form action={`https://formspree.io/f/${formspreeFormId}`} method="POST">
					<input type="hidden" name="_subject" value="santino.build contact form" />
					<div class="field">
						<label for="cf-name">{t('contact.name')}</label>
						<input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="200" />
					</div>
					<div class="field">
						<label for="cf-email">{t('contact.email')}</label>
						<input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="320" />
					</div>
					<div class="field">
						<label for="cf-message">{t('contact.message')}</label>
						<textarea id="cf-message" name="message" rows="6" required maxlength="5000" />
					</div>
					{/* Honeypot: hidden from people, filled by bots; Formspree drops submissions that fill it. */}
					<div class="hp" aria-hidden="true">
						<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
					</div>
					<button type="submit">{t('contact.send')}</button>
					<p class="privacy">{t('contact.privacy')}</p>
				</form>
			</section>
		)
	}
</BaseLayout>

<style>
	.body :global(p) {
		margin: 1rem 0 0;
	}

	.body :global(ul) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.body :global(ul a) {
		display: inline-block;
		padding: 0.5rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: 0.375rem;
		background: var(--color-surface);
		text-decoration: none;
	}

	.body :global(ul a:hover) {
		border-color: currentColor;
	}

	section {
		margin-top: 2.5rem;
	}

	h2 {
		margin: 0;
		font-size: 1.375rem;
	}

	form {
		display: grid;
		gap: 1rem;
		max-width: 36rem;
		margin-top: 1rem;
	}

	.field {
		display: grid;
		gap: 0.375rem;
	}

	label {
		font-weight: 600;
	}

	input,
	textarea {
		width: 100%;
		box-sizing: border-box;
		padding: 0.625rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: 0.375rem;
		background: var(--color-surface);
		color: inherit;
		font: inherit;
	}

	textarea {
		resize: vertical;
	}

	input:focus-visible,
	textarea:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	button {
		justify-self: start;
		padding: 0.625rem 1.5rem;
		border: 0;
		border-radius: 0.375rem;
		background: var(--color-accent);
		color: var(--color-bg);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	.hp {
		position: absolute;
		left: -10000px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	.privacy {
		margin: 0;
		color: var(--color-muted);
		font-size: 0.875rem;
	}
</style>
