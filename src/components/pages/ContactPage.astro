---
/** Contact page, shared by every locale: the Markdown body of pages/<locale>/contact.md. */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocale, useTranslations } from '../../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const entry = await getEntry('pages', `${locale}/contact`);
const Content = entry ? (await render(entry)).Content : undefined;
---

<BaseLayout
	title={entry?.data.title ?? t('nav.contact')}
	description={entry?.data.description ?? t('meta.contact')}
	draft={entry ? entry.data.translationStatus === 'draft' : undefined}
>
	<h1>{entry?.data.title ?? t('nav.contact')}</h1>

	{
		Content ? (
			<div class="body">
				<Content />
			</div>
		) : (
			<p>{t('page.comingSoon')}</p>
		)
	}
</BaseLayout>

<style>
	.body :global(p) {
		margin: 1rem 0 0;
	}

	.body :global(ul) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.body :global(ul a) {
		display: inline-block;
		padding: 0.5rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: 0.375rem;
		background: var(--color-surface);
		text-decoration: none;
	}

	.body :global(ul a:hover) {
		border-color: currentColor;
	}
</style>
