---
/** Contact page, shared by every locale. Content arrives in a later step. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocale, useTranslations } from '../../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<BaseLayout title={t('nav.contact')} description={t('meta.contact')}>
	<h1>{t('nav.contact')}</h1>
	<p>{t('page.comingSoon')}</p>
</BaseLayout>
