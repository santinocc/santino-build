<style>
	.site-footer {
		margin-top: 4rem;
		border-top: 1px solid var(--color-border);
		padding-block: 1.5rem;
		color: var(--color-muted);
		font-size: 0.875rem;
	}

	p {
		margin: 0;
	}
</style>
