---
/** Links to the current page in each locale. */
import { localeNames } from '../i18n/ui';
import { getAlternates, getLocale, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const alternates = getAlternates(Astro.url.pathname);
---

<nav class="lang" aria-label={t('lang.label')}>
	<ul>
		{
			alternates.map((alt) => (
				<li>
					<a
						href={alt.href}
						hreflang={alt.locale}
						lang={alt.locale}
						aria-current={alt.locale === locale ? 'true' : undefined}
					>
						{localeNames[alt.locale]}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	ul {
		display: flex;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.875rem;
	}

	a {
		color: var(--color-muted);
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}

	a[aria-current] {
		color: var(--color-text);
		font-weight: 600;
	}
</style>
