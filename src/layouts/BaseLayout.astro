---
/**
 * Shell for every page: <html lang>, meta and Open Graph tags, hreflang
 * alternates, header, footer, and the draft-translation notice.
 */
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { defaultLocale, uiTranslationStatus } from '../i18n/ui';
import { getAlternates, getLocale, useTranslations } from '../i18n/utils';

interface Props {
	/** Page title. Omit on the home page to show the site name alone. */
	title?: string;
	description: string;
	/** Shows the draft notice. Defaults to the review status of the locale's UI strings. */
	draft?: boolean;
}

const siteName = 'Santino Cervera';
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { title, description, draft = uiTranslationStatus[locale] === 'draft' } = Astro.props;

const fullTitle = title ? `${title} · ${siteName}` : siteName;
const alternates = getAlternates(Astro.url.pathname);
const canonical = alternates.find((alt) => alt.locale === locale)!.absoluteHref;
const xDefault = alternates.find((alt) => alt.locale === defaultLocale)!.absoluteHref;

const ogLocales = { en: 'en_US', ja: 'ja_JP', es: 'es_MX' } as const;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{alternates.map((alt) => <link rel="alternate" hreflang={alt.locale} href={alt.absoluteHref} />)}
		<link rel="alternate" hreflang="x-default" href={xDefault} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocales[locale]} />
		{
			alternates
				.filter((alt) => alt.locale !== locale)
				.map((alt) => <meta property="og:locale:alternate" content={ogLocales[alt.locale]} />)
		}

		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<a class="skip-link" href="#main">{t('a11y.skipToContent')}</a>
		{draft && <p class="draft-notice" role="note">{t('draft.notice')}</p>}
		<Header />
		<main id="main" class="container">
			<slot />
		</main>
		<Footer />
	</body>
</html>
